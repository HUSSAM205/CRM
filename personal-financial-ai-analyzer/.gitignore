# The enclosing repository's root .gitignore ignores every "data/" directory and every "*.log" file.
# Re-include this project's source package (src/data), small sample/reference data and evidence logs
# (audit defect A-08: they were silently missing from git, so fresh clones could not run).
!/src/data/
!/data/
!*.log

# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Datasets (too large for git; re-download + verify with scripts/download_dataset.py)
data/raw/*.parquet
data/raw/*.part
data/interim/
data/processed/
checkpoints/**/*.parquet

# Trained model binaries (~1.6 MB) ARE committed so the app runs from a fresh clone (DECISIONS D-19).
# They are pickles: load only artifacts produced by this repository's training scripts.

# Secrets
.env

# Supplementary public datasets (Dataset B): downloaded by scripts/download_supplementary.py, never committed
/data/supplementary/

# Launcher state (pid/port of the running dashboard; master audit 4)
.run/
